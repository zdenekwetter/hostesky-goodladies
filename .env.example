# =============================================================================
# Katalog hostesek GoodLadies – proměnné prostředí
#
# Na Vercelu je POVINNÁ JEN DATABASE_URL. Všechno ostatní má výchozí hodnotu nebo
# se nastavuje v administraci (záložka Nastavení). Tajné klíče si aplikace vygeneruje sama
# při první migraci a uloží do databáze.
#
# Lokálně: zkopírovat jako .env.local. Tento soubor NIKDY nenahrávat s vyplněnými hodnotami.
# =============================================================================

# Připojení k databázi Neon (vlastník databáze, např. neondb_owner; adresa s -pooler)
DATABASE_URL=postgresql://neondb_owner:HESLO@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Volitelné (proměnná má přednost před nastavením v administraci) ----------
# SITE_URL=https://katalog.goodladies.cz          # jinak se vezme z domény Vercelu
# MAKE_WEBHOOK_URL=https://hook.eu2.make.com/…     # výchozí: webhook formuláře na goodladies.cz/hostesky/
# GOOGLE_BRIDGE_URL=https://script.google.com/macros/s/…/exec
# PRICE_TEXT=Od 3 700 Kč za hostesku a den. …
# ADMIN_BOOTSTRAP_EMAIL=zuzana.pribylova@goodladies.cz   # kdo smí založit první účet
# ADMIN_EMAIL_DOMAIN=goodladies.cz
# CONTACT_PHONE=+420 736 705 423
# CONTACT_EMAIL=info@goodladies.cz
# SESSION_SECRET= / INGEST_SECRET= / CRON_SECRET=  # jinak odvozené z tajného klíče v databázi
